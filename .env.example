# Janaseva Kerala Environment Variables
# Copy to .env for local development

# Security & Application
DEBUG=True
SECRET_KEY=django-insecure-janaseva-kerala-secret-key-change-in-production-2026-xyz
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com

# Frontend and CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Database (Leave empty for default SQLite in local development; provide Neon PostgreSQL URL in production)
# Example Neon Direct: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require
# Example Neon Pooler: postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=600

# AI Integration (Google Gemini API)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudinary Storage (Optional in dev, recommended in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
